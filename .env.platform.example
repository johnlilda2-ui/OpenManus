# OpenManus Operational Platform
OPENMANUS_ENV=development
OPENMANUS_AUTO_CREATE_DB=true
OPENMANUS_JWT_SECRET=replace-with-a-long-random-secret
OPENMANUS_JWT_SECRET_FILE=/run/secrets/openmanus_jwt_secret
OPENMANUS_JWT_ALGORITHM=HS256
OPENMANUS_ACCESS_TOKEN_MINUTES=60
OPENMANUS_QUEUE=openmanus:tasks
OPENMANUS_BUILDER_QUEUE=openmanus:app-builder
OPENMANUS_WORKFLOW_STALE_SECONDS=900
OPENMANUS_SANDBOX_ENABLED=false
OPENMANUS_SANDBOX_BACKEND=none
OPENMANUS_ARTIFACT_ROOT=./platform_data/artifacts
OPENMANUS_ARTIFACT_MAX_BYTES=52428800
OPENMANUS_USAGE_INPUT_RATE=0.003
OPENMANUS_USAGE_OUTPUT_RATE=0.015
OPENMANUS_RATE_LIMIT_PER_MINUTE=120
OPENMANUS_RATE_LIMIT_AUTH_PER_MINUTE=10
OPENMANUS_RATE_LIMIT_FAIL_OPEN=true
OPENMANUS_MODEL_PLANNER=planner
OPENMANUS_MODEL_BUILDER=builder
OPENMANUS_MODEL_DESIGNER=designer
OPENMANUS_MODEL_TESTER=tester
OPENMANUS_MODEL_FIXER=fixer
OPENMANUS_MODEL_REVIEWER=reviewer
OPENMANUS_S3_BUCKET=
OPENMANUS_S3_ENDPOINT_URL=
AWS_REGION=
DATABASE_URL=postgresql+asyncpg://openmanus:openmanus@localhost:5432/openmanus
REDIS_URL=redis://localhost:6379/0
OPENMANUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
